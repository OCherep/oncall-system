# Public
APP_PUBLIC_URL=https://s.ks.tv:85
TLS_CN=s.ks.tv
LETSENCRYPT_EMAIL=you@company.com
SESSION_SECURE=1

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_TEAM_CHANNEL=C...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Webhooks
ENABLE_INCIDENT_WEBHOOK=0
WEBHOOK_SECRET=
# ^ ОБОВ'ЯЗКОВО (>=16 симв., `openssl rand -hex 24`). Порожнє/«change-me» → webhook вимкнено, deploy.sh FAIL

# Security (обов'язково перед деплоєм; дефолтів немає — fail closed)
# Другий фактор DB-інструментів адмінки (>=16 симв.). Порожнє → DB-інструменти вимкнено, deploy.sh FAIL
DB_ADMIN_PASSWORD=
# Підпис Slack (Signing Secret застосунку). Порожнє → /api/webhooks/slack вимкнено (403)
SLACK_SIGNING_SECRET=
# Read-only токен для серверних клієнтів /api/data (DevOps Hub mentions, заголовок X-Oncall-Read-Token)
ONCALL_READ_TOKEN=
# Лише для ПОРОЖНЬОЇ БД: пароль першого admin (>=12 симв.). Дефолтного admin/admin більше немає
ONCALL_BOOTSTRAP_ADMIN_PASSWORD=
# SOFT_AUTH видалено: заголовок X-Oncall-User не автентифікує

# Jira (optional)
JIRA_ENABLED=0
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
