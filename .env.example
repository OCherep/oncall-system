# Public
APP_PUBLIC_URL=https://s.ks.tv:85
TLS_CN=s.ks.tv
LETSENCRYPT_EMAIL=you@company.com
SESSION_SECURE=1

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_TEAM_CHANNEL=C...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Щодня перезапис складу Slack-user group лише сьогоднішніми черговими.
# Потрібні scopes: usergroups:read, usergroups:write. У членів команди має бути slack_id.
SLACK_ONCALL_GROUP_SYNC=1
SLACK_ONCALL_HANDLE=oncall
# SLACK_ONCALL_USERGROUP=S0123456789

# Webhooks
ENABLE_INCIDENT_WEBHOOK=0
WEBHOOK_SECRET=change-me

# Jira (optional)
JIRA_ENABLED=0
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
